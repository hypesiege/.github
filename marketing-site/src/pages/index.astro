---
const features = [
  ["Unified content calendar", "Plan drafts, scheduled posts, campaigns, variants, and account destinations without flattening every network into one field set."],
  ["Approval before execution", "Keep authoring, review, approval, scheduling, and delivery as separate, observable states."],
  ["Deterministic queue", "Idempotency keys, due times, leases, attempts, and terminal outcomes make scheduled work restart-safe."],
  ["Account boundaries", "Treat connected social accounts and credentials as scoped destinations—not values copied into post documents."],
  ["Polyglot clients", "TypeScript, Dart, and Rust expose the same account, post, schedule, and queue operation families."],
  ["Delivery evidence", "Capture provider receipts, failures, retries, and per-destination results instead of declaring a campaign sent too early."],
];
const samples = [
  { id:"typescript", label:"TypeScript", file:"schedule.ts", code:`import { HypeSiegeClient } from "@hypesiege/client";

const client = new HypeSiegeClient({ baseUrl, accessToken });
const post = await client.posts.create({
  campaignId: "campaign_01J...",
  text: "The launch is live.",
  destinations: [linkedinAccount, xAccount],
});

const scheduled = await client.schedules.create({
  postId: post.id,
  publishAt: "2026-08-06T14:00:00Z",
  idempotencyKey: "launch-wave-1",
});
console.log(scheduled.id, scheduled.state);`, note:"Representative use of the TypeScript account, post, and scheduling surface in `hypesiege-clients`." },
  { id:"dart", label:"Dart / Flutter", file:"schedule.dart", code:`final client = HypeSiegeClient(
  baseUrl: baseUrl,
  accessToken: accessToken,
);
final post = await client.posts.create(
  campaignId: 'campaign_01J...',
  text: 'The launch is live.',
  destinations: [linkedinAccount, xAccount],
);
final scheduled = await client.schedules.create(
  postId: post.id,
  publishAt: DateTime.parse('2026-08-06T14:00:00Z'),
  idempotencyKey: 'launch-wave-1',
);
print('${scheduled.id} ${scheduled.state}');`, note:"The Dart package carries the same scheduling resources into Flutter planning and review applications." },
  { id:"rust", label:"Rust", file:"schedule.rs", code:`let client = HypeSiegeClient::new(base_url, access_token)?;
let post = client.posts().create(CreatePost {
    campaign_id: "campaign_01J...".into(),
    text: "The launch is live.".into(),
    destinations,
}).await?;

let scheduled = client.schedules().create(CreateSchedule {
    post_id: post.id,
    publish_at,
    idempotency_key: "launch-wave-1".into(),
}).await?;
println!("{} {}", scheduled.id, scheduled.state);`, note:"The Rust client uses the same typed account, post, schedule, and queue boundaries for services and CLIs." },
  { id:"queue", label:"Queue document", file:"queue-item.json", code:`{
  "queueItemId": "queue_01J...",
  "scheduleId": "schedule_01J...",
  "postId": "post_01J...",
  "destinationAccountId": "account_01J...",
  "dueAt": "2026-08-06T14:00:00Z",
  "state": "ready",
  "attempt": 0,
  "idempotencyKey": "launch-wave-1:linkedin",
  "lease": null
}`, note:"One scheduled post expands into destination-specific queue work with explicit dedupe and delivery state." },
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Campaign planning, approvals, scheduling, and deterministic social delivery queues."><meta name="theme-color" content="#100b0d"><title>HypeSiege — plan the campaign, hold the queue</title></head><body>
<header><a class="brand" href="/"><b>HS</b><span>HypeSiege</span></a><nav><a href="#platform">Platform</a><a href="#clients">Clients</a><a href="https://github.com/hypesiege">GitHub ↗</a></nav></header><main>
<section class="hero"><div><p class="eyebrow">Campaign operations · Deterministic scheduling</p><h1>Plan the campaign. <em>Hold the queue.</em></h1><p class="lede">HypeSiege separates content, approvals, account destinations, scheduled intent, queue execution, and provider outcomes—so a campaign can move quickly without becoming unpredictable.</p><div class="actions"><a class="primary" href="https://github.com/hypesiege/hypesiege-clients">Explore the clients ↗</a><a href="#clients">Choose a language</a></div><ul><li>TypeScript · Dart · Rust</li><li>Approval-aware calendar</li><li>Idempotent delivery queue</li></ul></div>
<div class="visual"><span class="grid"></span><div class="calendar"><small>AUG 06</small><strong>LAUNCH WAVE</strong><i>14:00 UTC</i></div><div class="core"><small>QUEUE STATE</small><strong>12 ready</strong><i>3 leased · 0 failed</i></div><div class="chip c1">APPROVAL<b>granted</b></div><div class="chip c2">ACCOUNTS<b>4 connected</b></div><div class="chip c3">DESTINATIONS<b>12 jobs</b></div><div class="chip c4">OUTCOMES<b>pending</b></div><svg viewBox="0 0 500 420"><path d="M250 95L250 210M250 210L90 330M250 210L250 330M250 210L410 330"/></svg></div></section>
<section class="metrics"><div><b>3</b><span>official clients</span></div><div><b>5</b><span>content lifecycle states</span></div><div><b>1</b><span>job per destination</span></div><div><b>0</b><span>implicit duplicate sends</span></div></section>
<section id="platform" class="platform"><p class="eyebrow">Campaign control, not a timer table</p><h2>Scheduling is a state machine with evidence.</h2><p class="intro">A draft is not approved. An approved post is not queued. A queued destination is not delivered. HypeSiege preserves those distinctions so humans, automations, and providers can each own the correct transition.</p><div class="features">{features.map(([title,body],index)=><article><small>{String(index+1).padStart(2,"0")}</small><h3>{title}</h3><p>{body}</p></article>)}</div></section>
<section id="clients" class="sdk" data-sdk><div><p class="eyebrow">Official client workbench</p><h2>Plan and observe campaigns from the runtime already in your stack.</h2><p class="intro">The client matrix exposes account, post, scheduling, and queue operations through one shared contract. Provider credentials remain at the service boundary rather than inside post documents.</p><a class="source-link" href="https://github.com/hypesiege/hypesiege-clients">Browse hypesiege-clients ↗</a></div><div class="workbench"><div class="toolbar"><label><span>Language</span><select aria-label="Select client language" data-language>{samples.map((sample,index)=><option value={sample.id} selected={index===0}>{sample.label}</option>)}</select></label><code data-file>{samples[0]?.file ?? "schedule.ts"}</code><button type="button" data-copy>Copy</button></div>{samples.map((sample,index)=><article data-sample={sample.id} data-name={sample.file} hidden={index!==0}><pre tabindex="0"><code>{sample.code}</code></pre><p>{sample.note}</p></article>)}</div></section>
<section class="closing"><p class="eyebrow">Build momentum without losing control</p><h2>Make every post intentional, approved, and observable.</h2><a href="https://github.com/hypesiege">Open the organization ↗</a></section></main><footer><span>© 2026 HypeSiege</span><a href="https://github.com/hypesiege/hypesiege-clients">Client packages</a></footer>
<script is:inline>document.querySelectorAll('[data-sdk]').forEach((root)=>{const select=root.querySelector('[data-language]'),file=root.querySelector('[data-file]'),copy=root.querySelector('[data-copy]'),panels=[...root.querySelectorAll('[data-sample]')];const show=(id)=>panels.forEach((panel)=>{const active=panel.dataset.sample===id;panel.hidden=!active;if(active)file.textContent=panel.dataset.name||''});select?.addEventListener('change',(event)=>show(event.target.value));copy?.addEventListener('click',async()=>{const active=panels.find((panel)=>!panel.hidden),text=active?.querySelector('code')?.textContent||'';try{await navigator.clipboard.writeText(text);copy.textContent='Copied'}catch{active?.querySelector('pre')?.focus();copy.textContent='Select code'}setTimeout(()=>copy.textContent='Copy',1200)})});</script>
<style>:root{--accent:#e11d48;--hot:#f97316;--ink:#100b0d;--muted:#706269;--paper:#fff8f8}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:linear-gradient(180deg,#fff1f2,var(--paper) 36rem);color:var(--ink);font:16px/1.6 Inter,ui-sans-serif,system-ui,sans-serif}a{color:inherit}header,main,footer{width:min(1180px,calc(100% - 2rem));margin:auto}header{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 0}.brand{display:flex;gap:.6rem;align-items:center;font-weight:900;text-decoration:none}.brand b{display:grid;width:2.35rem;aspect-ratio:1;place-items:center;border-radius:.75rem;background:var(--ink);color:white;font-size:.7rem}nav{display:flex;gap:1.2rem;font-size:.85rem;font-weight:800}nav a{text-decoration:none}.hero{display:grid;grid-template-columns:1.04fr .96fr;gap:clamp(2rem,7vw,7rem);align-items:center;min-height:720px;padding:5rem 0}.eyebrow{margin:0;color:var(--accent);font:800 .7rem/1 ui-monospace,monospace;letter-spacing:.17em;text-transform:uppercase}h1{max-width:12ch;margin:.8rem 0 1.25rem;font-size:clamp(3.5rem,8vw,7rem);line-height:.86;letter-spacing:-.075em}h1 em{background:linear-gradient(120deg,var(--accent),var(--hot));background-clip:text;color:transparent;font-style:normal}.lede,.intro{max-width:48rem;color:var(--muted);font-size:1.08rem}.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:2rem 0}.actions a,.closing a{padding:.75rem 1rem;border:1px solid #4c05191b;border-radius:.75rem;font-weight:850;text-decoration:none}.primary{background:var(--ink);color:white}.hero ul{display:flex;gap:1rem;flex-wrap:wrap;margin:0;padding:0;color:var(--muted);font-size:.8rem;list-style:none}.hero li:before{content:'◆';margin-right:.4rem;color:var(--accent)}.visual{position:relative;min-height:32rem;overflow:hidden;border-radius:2rem;background:radial-gradient(circle at 50% 48%,#e11d4847,transparent 40%),linear-gradient(145deg,#15080d,#3f101f);box-shadow:0 35px 90px #88133740}.grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff0c 1px,transparent 1px),linear-gradient(90deg,#ffffff0c 1px,transparent 1px);background-size:2.4rem 2.4rem}.visual svg{position:absolute;inset:0;width:100%;height:100%;fill:none;stroke:#fb71858c;stroke-width:2}.calendar,.core,.chip{position:absolute;z-index:2;display:grid;padding:.9rem;border:1px solid #ffffff25;border-radius:1rem;background:#300d18df;color:#fda4af;backdrop-filter:blur(12px);font:700 .64rem/1.5 ui-monospace,monospace}.calendar{top:8%;left:50%;width:13rem;padding:1.15rem;transform:translateX(-50%)}.calendar strong,.core strong,.chip b{color:white}.calendar strong{font-size:1.08rem}.calendar i,.core i{font-style:normal}.core{top:50%;left:50%;width:14rem;padding:1.2rem;transform:translate(-50%,-50%)}.core strong{font-size:1.28rem}.c1{bottom:8%;left:4%}.c2{bottom:8%;left:28%}.c3{right:28%;bottom:8%}.c4{right:4%;bottom:8%}.metrics{display:grid;grid-template-columns:repeat(4,1fr);overflow:hidden;border:1px solid #88133718;border-radius:1.15rem;background:#ffffffc9}.metrics div{display:grid;padding:1.2rem}.metrics div+div{border-left:1px solid #88133718}.metrics b{font-size:1.3rem}.metrics span{color:var(--muted);font-size:.76rem}.platform{padding:8rem 0}.platform h2,.sdk h2,.closing h2{max-width:15ch;margin:.55rem 0 1rem;font-size:clamp(2.6rem,6vw,5rem);line-height:.94;letter-spacing:-.06em}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.features article{min-height:14rem;padding:1.3rem;border:1px solid #88133714;border-radius:1.1rem;background:#ffffffc5}.features small{color:var(--accent);font:800 .68rem/1 ui-monospace,monospace}.features h3{margin:2.1rem 0 .55rem}.features p{color:var(--muted)}.sdk{display:grid;grid-template-columns:minmax(0,.78fr) minmax(31rem,1.22fr);gap:clamp(2rem,7vw,6rem);align-items:center;margin:3rem 0 9rem}.source-link{display:inline-block;margin-top:1rem;color:var(--accent);font-weight:850;text-decoration:none}.workbench{overflow:hidden;border:1px solid #ffffff24;border-radius:1.25rem;background:#15080d;color:#ffe4e6;box-shadow:0 32px 90px #88133740}.toolbar{display:flex;gap:.8rem;align-items:end;padding:.85rem 1rem;border-bottom:1px solid #ffffff18;background:#2d0b16}.toolbar label{display:grid;gap:.25rem}.toolbar label span{color:#fda4af;font:700 .6rem/1 ui-monospace,monospace;letter-spacing:.13em;text-transform:uppercase}.toolbar select,.toolbar button{border:1px solid #ffffff28;border-radius:.58rem;background:#491022;color:white;padding:.5rem .65rem;font:inherit}.toolbar button{margin-left:auto;cursor:pointer}.toolbar>code{align-self:center;color:#fda4af;font-size:.75rem}.workbench pre{overflow:auto;min-height:23rem;max-height:31rem;margin:0;padding:1.2rem;font:500 .82rem/1.7 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre}.workbench article>p{margin:0;padding:.8rem 1.2rem 1rem;border-top:1px solid #ffffff15;color:#fda4af;font-size:.78rem}.closing{margin-bottom:2rem;padding:clamp(2rem,7vw,6rem);border-radius:1.8rem;background:linear-gradient(125deg,var(--accent),var(--hot));color:white}.closing .eyebrow{color:#ffffffc7}.closing a{display:inline-block;margin-top:1rem;background:white;color:var(--ink)}footer{display:flex;gap:1rem;padding:1.5rem 0 3rem;color:var(--muted);font-size:.78rem}footer span{margin-right:auto}footer a{text-decoration:none}@media(max-width:900px){.hero,.sdk{grid-template-columns:1fr}.features{grid-template-columns:1fr 1fr}}@media(max-width:650px){nav a:not(:last-child){display:none}.visual{min-height:27rem}.c2,.c3{display:none}.metrics{grid-template-columns:1fr 1fr}.features{grid-template-columns:1fr}.toolbar{align-items:stretch;flex-wrap:wrap}.toolbar>code{width:100%;order:3}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}</style></body></html>
